# --- Database (Neon Postgres) ---
# Set automatically when you connect Neon via Vercel marketplace.
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# --- Chain ---
# Free RPC with no eth_getLogs cap. Alternative: Alchemy.
RPC_URL=https://base.drpc.org
CHAIN_ID=8453

# Block window per getLogs call. Indexer auto-shrinks on RPC range errors.
LOG_BATCH_SIZE=2000

# Override only if you've forked the contract.
# CHANNELS_ADDRESS=0xBA66d3b4fbCf472F6F11D6F9F96aaCE96516F09d
# START_BLOCK=45667842

# --- Cron auth ---
# Random secret. Generate with: openssl rand -hex 32
# Both Vercel Cron and external pingers (cron-job.org) must send:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-me-with-random-hex
